{
    "name": "setasign/setapdf-signer-addon-azure-keyvault",
    "description": "A SetaPDF-Signer component signature module for the Azure KeyVault.",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/Setasign/SetaPDF-Signer-Addon-Azure-KeyVault",
    "authors": [
        {
            "name": "Setasign GmbH & Co. KG",
            "email": "support@setasign.com"
        }
    ],
    "require": {
        "php": ">=7.2 <=8.5.99999",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "setasign/setapdf-signer": "^2.47"
    },
    "require-dev": {
